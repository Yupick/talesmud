# Application settings
GIN_MODE=debug
LOG_LEVEL=debug
# Rotating application log (7-day retention via lumberjack). Default: logs/talesmud.log
LOG_FILE=logs/talesmud.log
PORT=8010

# HTTP server timeouts (Go duration syntax "5s"/"1m" or bare seconds).
# ReadHeaderTimeout bounds slowloris; Read/Write bound slow bodies; Idle bounds
# keep-alive reuse. WebSocket sessions are hijacked and clear their deadlines.
HTTP_READ_HEADER_TIMEOUT=5s
HTTP_READ_TIMEOUT=15s
HTTP_WRITE_TIMEOUT=30s
HTTP_IDLE_TIMEOUT=60s

# Authentication
# AUTH_MODE selects how registered users sign in:
#   local -> built-in username/password accounts (Argon2id) with JWT sessions.
#            This is the fork default. POST /api/auth/register|login and
#            GET /api/auth/me are enabled; no Auth0 tenant is needed.
#   auth0 -> external Auth0 tenant. Only set this to keep upstream Auth0 login;
#            then AUTH0_AUDIENCE / AUTH0_DOMAIN / AUTH0_WK_JWKS are required.
AUTH_MODE=local

# Auth0 values are only read when AUTH_MODE=auth0.
# Guest sessions always use local HMAC tokens and work in either mode.
# REST APIs require an Authorization: Bearer token. WebSockets use POST /api/ws-ticket.

# Comma-separated extra CORS / WebSocket origins (production + localhost are built in).
CORS_ALLOWED_ORIGINS=

# Proxies whose X-Forwarded-For header is trusted for ClientIP (guest rate limits).
# Default: 127.0.0.1,::1 — do not set 0.0.0.0/0.
TRUSTED_PROXIES=127.0.0.1,::1

# Set to 1 only if you must run legacy Otto JavaScript world scripts.
TALESMUD_ALLOW_JS_SCRIPTS=

# Legacy admin import/export credentials. Leave either value blank to disable those endpoints.
# Rejected if user is admin/password/changeme or password is shorter than 12 characters.
ADMIN_USER=
ADMIN_PASSWORD=

# Auth0 SPA (frontend build-time). Only needed when AUTH_MODE=auth0; leave
# blank for local auth so the SPA does not try to initialize Auth0.
VITE_AUTH0_DOMAIN=your-tenant.auth0.com
VITE_AUTH0_CLIENT_ID=
VITE_AUTH0_AUDIENCE=http://localhost:8010/api

# Auth0 backend (only required when AUTH_MODE=auth0)
AUTH0_AUDIENCE=http://localhost:8010/api
AUTH0_DOMAIN=https://your-tenant.auth0.com/
AUTH0_WK_JWKS=https://your-tenant.auth0.com/.well-known/jwks.json
# Timeout for the JWKS HTTP fetch (default 10s).
JWKS_TIMEOUT_SECONDS=10

# Guest mode secret key for signing guest JWTs (HMAC-SHA256)
# If not set, a random key is generated at startup (guest tokens won't survive server restart)
GUEST_SECRET=

# Confirmed device-login account sessions (classic only, 30-minute JWTs).
# Unset: reuse game-mode session_secret or persist a key at secret_path
# (default data/session.key, mode 0600).
SESSION_SECRET=
# Public origin and existing browser confirmation page; required for device start.
SSH_ACTIVATE_URL=http://localhost:8010/activate

# SQLite database path
SQLITE_PATH=./talesmud.db

# Background images storage path
BACKGROUNDS_PATH=./uploads/backgrounds

# LLM
# Swappable provider behind POST /api/generate/character (character
# name/description generation). A nil provider disables generation
# (the endpoint answers 503 "AI generation is not configured").
#   ollama  -> local Ollama daemon (default, no API key needed)
#   groq    -> hosted Groq API (requires GROQ_API_KEY)
#   none/off (or empty) -> generation disabled
# Unset (backward compatibility): GROQ_API_KEY present -> Groq,
# otherwise Ollama. Unknown values disable generation.
LLM_PROVIDER=ollama
# Local Ollama daemon (OpenAI-compatible endpoint).
OLLAMA_BASE_URL=http://localhost:11434
# Model downloaded in the local Ollama daemon.
OLLAMA_MODEL=llama3.1
# HTTP timeout of the Ollama client (local inference is slower than
# hosted APIs; Groq uses its own fixed 15s timeout).
LLM_TIMEOUT_SECONDS=60
# Groq API key (https://console.groq.com). Only used by the groq
# provider; the Groq model is llama-3.3-70b-versatile.
GROQ_API_KEY=

# Dungeon Master narration (Phase 6.5, mode A). The DM only emits prose:
# it never changes game state. With no LLM provider the DM stays silent.
# Kill switch: 0/false/off disables every DM event.
LLM_DM_ENABLED=1
# Cooldown between narrations for the same room (or user for private events).
LLM_DM_COOLDOWN_SECONDS=45
# Hard timeout per narration. The DM makes a single attempt and drops the
# line if it does not arrive in time.
LLM_DM_TIMEOUT_SECONDS=8
# Global cap of DM narrations per minute across every room. 0 falls back to
# the default (10); a negative value disables the budget.
LLM_DM_MAX_PER_MIN=10
